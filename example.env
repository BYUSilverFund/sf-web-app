# ==========================================
# Silver Fund Web App - Environment Variables
# ==========================================
# Copy this file to `.env.local` for local development.

# --- Backend REST API ---
# Base URL for the Silver Fund FastAPI backend service (e.g. http://127.0.0.1:8000 for local development)
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000

# --- AWS Cognito Authentication ---
# AWS region where the Cognito User Pool is hosted (e.g. us-east-1, us-west-2)
NEXT_PUBLIC_COGNITO_REGION=us-west-2

# ID of the AWS Cognito User Pool (configured in sf-aws-terraform/cognito.tf)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# App Client ID for the web frontend within the Cognito User Pool
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=

# --- GraphQL API ---
# AWS AppSync / GraphQL API endpoint URL
NEXT_PUBLIC_GRAPHQL_ENDPOINT=

# API key used to authenticate requests to the GraphQL endpoint
NEXT_PUBLIC_GRAPHQL_API_KEY=



